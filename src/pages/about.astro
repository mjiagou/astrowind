---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';

const metadata = {
  title: '关于极酷家 - 00后数字基地',
};
---

<Layout metadata={metadata}>
  <!-- 品牌故事 -->
  <Hero
    tagline="About Us"
    title="极酷家：为了更有趣的数字生活"
    subtitle="我们是一群不想被算法裹挟、不想用千篇一律软件的 Z 世代和 Alpha 世代。在这里，技术是用来打破边界的。"
  />

  <!-- 网站数据（增强信任感） -->
  <Stats
    title="目前我们拥有..."
    stats={[
      { title: '收录黑名单', amount: '3.4K+' },
      { title: 'LiteLoader 插件', amount: '50+' },
      { title: '黑话词条', amount: '200+' },
      { title: '月访问量', amount: '10W+' },
    ]}
  />

  <!-- 价值观 -->
  <Features3
    title="我们的原则"
    columns={3}
    items={[
      {
        title: '开源透明',
        description: '所有的修改教程和代码均开源，拒绝恶意后门和强制收费。',
        icon: 'tabler:brand-open-source',
      },
      {
        title: '社区共治',
        description: '黑名单数据来源于社区用户的真实投递与核实，绝不私自篡改。',
        icon: 'tabler:users',
      },
      {
        title: '技术中立',
        description: '我们研究技术是为了美化与增强，坚决反对利用技术进行灰产和破坏。',
        icon: 'tabler:scale',
      },
    ]}
  />
</Layout>