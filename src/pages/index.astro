---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '极酷家 JiKuJia - 00后/10后 QQ 高阶玩家基地',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <!-- 首页头图：核心视觉区域 -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: '开始搞机',
        href: '/docs/liteloader-plugin-dev-101', // 指向你的核心教程
        target: '_blank',
        icon: 'tabler:rocket',
      },
      { text: '查询黑名单', href: '/blacklist', icon: 'tabler:shield-check' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'JiKuJia Hero Image' }}
  >
    <Fragment slot="title">
      探索 QQ 的 <span class="text-accent dark:text-white highlight">无限可能</span><br />
      <span class="text-2xl md:text-4xl text-gray-500 dark:text-slate-400 font-medium">极酷家 JiKuJia</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline"> 专为 <span class="font-semibold">00后 / 10后</span> 打造的数字生存指南。</span>
      从 LiteLoader 插件开发、NT 架构美化，到设圈/绘圈 <span class="font-semibold">避雷黑名单</span
      >，这里有你想要的一切黑科技。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->
  <!-- 滚动通知栏：展示 Slogan -->
  <Note />

  <!-- Features Widget ****************** -->
  <!-- 核心功能：三大支柱 -->
  <Features
    id="features"
    tagline="Why JiKuJia?"
    title="为什么选择极酷家？"
    subtitle="我们将硬核技术与社交生存法则结合，为你提供独一无二的数字体验。"
    items={[
      {
        title: 'QQ NT 深度美化',
        description:
          '基于 Electron 的 NT 架构深度解析。教你注入 CSS、JS，让你的 QQ 界面变成磨砂玻璃、全透明或赛博朋克风格。',
        icon: 'tabler:brush',
      },
      {
        title: '社交黑话破译',
        description: '看不懂 "cqy", "nss", "跑单"？收录 2026 年最新扩列圈、设圈、绘圈术语，拒绝做局外人。',
        icon: 'tabler:vocabulary',
      },
      {
        title: '安全避坑雷达',
        description: '独家维护的“跑单/诈骗黑名单”数据库。交易前搜一搜，远离 AI 换脸诈骗和赛博仙人跳。',
        icon: 'tabler:shield-lock',
      },
      {
        title: '机器人开发',
        description: '想做一个懂你的 Bot？从 Python 到 Node.js，手把手教你搭建群管、点歌、陪聊机器人。',
        icon: 'tabler:robot',
      },
      {
        title: '开源与共享',
        description: '我们推崇开源精神。所有的插件代码、脚本工具均在 GitHub 开放，安全透明，拒绝后门。',
        icon: 'tabler:brand-github',
      },
      {
        title: '极客社区',
        description: '聚集 15-25 岁的技术爱好者。这里没有说教，只有纯粹的技术交流和搞机乐趣。',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Content Widget ******************* -->
  <!-- 深度展示：LiteLoader -->
  <Content
    isReversed
    tagline="玩机实验室"
    title="突破官方限制：LiteLoaderQQNT"
    items={[
      {
        title: '无感注入',
        description: '利用 2026 最新注入技术，不修改 exe 文件，安全稳定，大幅降低封号风险。',
      },
      {
        title: '插件市场',
        description: '一键安装防撤回、以图搜图、自动回复等几十款实用插件，像给浏览器装扩展一样简单。',
      },
      {
        title: '主题引擎',
        description: '支持 .css 主题文件热重载。想要 iOS 风？Windows 11 云母风？随心所欲。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1614064641938-3bcee52942c7?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">你的 QQ，理应更酷</h3>
      告别千篇一律的白色窗口。通过 LiteLoader，你将拥有完全的控制权。
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget ******************* -->
  <!-- 深度展示：安全中心 -->
  <Content
    isAfterContent
    items={[
      {
        title: '黑名单查询',
        description: `输入 QQ 号，一键查询对方是否有跑单、诈骗、挂人等不良记录。数据由社区用户实时投递。`,
      },
      {
        title: 'AI 诈骗预警',
        description: '针对 2026 年爆发的 Deepfake 视频诈骗，提供硬核的辨别技巧和防御手段。',
      },
      {
        title: '扩列文案库',
        description: '不知道怎么发说说？海量扩列文案一键复制，让你在万能墙上脱颖而出。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Cyberpunk Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">社交百科 & 安全雷达</h3>
      混圈子，最重要的是“眼亮”和“话懂”。极酷家助你从萌新进化为老手。
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <!-- 步骤指引：如何开始 -->
  <Steps
    title="只需 3 步，开启极客之旅"
    items={[
      {
        title: 'Step 1: <span class="font-medium">浏览教程</span>',
        description: '进入【玩机实验室】，选择适合你系统的 LiteLoader 安装教程。',
        icon: 'tabler:book',
      },
      {
        title: 'Step 2: <span class="font-medium">下载资源</span>',
        description: '获取核心注入文件及推荐的插件包（防撤回、MoeGlass）。',
        icon: 'tabler:download',
      },
      {
        title: 'Step 3: <span class="font-medium">加入社区</span>',
        description: '关注最新黑话动态，或者向黑名单系统投递你遇到的骗子信息。',
        icon: 'tabler:users',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- BlogLatestPosts Widget ******* -->
  <!-- 最新文章：调用你刚写的内容 -->
  <BlogLatestPosts
    id="blog"
    title="最新情报 & 避坑指南"
    information={`这里汇集了 2026 年最新的 QQ 玩机技巧、社群黑话解析以及高危诈骗预警。`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>

  <!-- CallToAction Widget *********** -->
  <!-- 底部 CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '立即查询黑名单',
        href: '/blacklist',
        icon: 'tabler:search',
      },
    ]}
  >
    <Fragment slot="title">
      <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">交易前，先查一下</span>
    </Fragment>

    <Fragment slot="subtitle"> 不要让你的零花钱变成骗子的业绩。极酷家黑名单系统，为你的社交保驾护航。 </Fragment>
  </CallToAction>
</Layout>
