---
import Layout from '~/layouts/PageLayout.astro';
import slangData from '../data/slang.json';

const metadata = { title: '社交百科 - 极酷家' };
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 mx-auto max-w-7xl">
    <h1 class="text-4xl font-bold text-center mb-12">QQ 社交词典</h1>
    <div class="grid gap-6 md:grid-cols-2">
      {slangData.map((item) => (
        <div class="p-6 border rounded-lg shadow-sm hover:shadow-md transition">
          <h2 class="text-xl font-bold text-blue-600">{item.word}</h2>
          <p class="text-gray-700 font-medium">{item.mean}</p>
          <p class="text-sm text-gray-500 mt-2">{item.detail}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>